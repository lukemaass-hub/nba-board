{
  "manifest_version": 3,
  "name": "Prop Price Compare (DK / FD / Dolly)",
  "version": "0.22.0",
  "description": "Pulls NBA player points and alternate points from DraftKings, FanDuel and the Dolly Market Manager screen (test by default; prod only if ticked; both at once to compare) every 15 seconds, lines them up, graphs them, and exports to CSV / Google Sheets.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "webNavigation",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://*.sportsbook.fanduel.com/*",
    "https://dolly.uat.oddsfactorytrading.bet/*",
    "https://site.api.espn.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "book_api_headers",
        "enabled": true,
        "path": "rules/book-api-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the prop compare dashboard"
  },
  "optional_host_permissions": [
    "https://dolly.1.oddsfactorytrading.com/*"
  ]
}
