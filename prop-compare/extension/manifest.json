{
  "manifest_version": 3,
  "name": "Prop Price Compare (DK / FD / Dolly)",
  "version": "0.23.0",
  "description": "Pulls NBA player points and alternate points from DraftKings and FanDuel. DISCONNECTED from Dolly (Oct 22 2026, Dolly was lagging): it no longer reads any Dolly page.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "webNavigation",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://*.sportsbook.fanduel.com/*",
    "https://site.api.espn.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "book_api_headers",
        "enabled": true,
        "path": "rules/book-api-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the prop compare dashboard"
  }
}
