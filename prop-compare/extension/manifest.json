{
  "manifest_version": 3,
  "name": "Prop Price Compare (DK / FD / Dolly)",
  "version": "0.14.0",
  "description": "Pulls NBA player points and alternate points from DraftKings, FanDuel and the Dolly TEST (UAT) Market Manager screen every 15 seconds, lines them up, graphs them, and exports to CSV / Google Sheets.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://*.sportsbook.fanduel.com/*",
    "https://dolly.uat.oddsfactorytrading.bet/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "book_api_headers",
        "enabled": true,
        "path": "rules/book-api-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the prop compare dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dolly.uat.oddsfactorytrading.bet/*"
      ],
      "js": [
        "content/dolly-props.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
