{
  "manifest_version": 3,
  "name": "Prop Price Compare (DK / FD / Ours)",
  "version": "0.8.0",
  "description": "Pulls NBA player points and alternate points from DraftKings and FanDuel every 15 seconds, lines them up tick by tick, graphs them, and exports to CSV / Google Sheets.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://*.sportsbook.fanduel.com/*",
    "https://content.1.betfanatics.com/*",
    "https://trading.1.betfanatics.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "book_api_headers",
        "enabled": true,
        "path": "rules/book-api-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the prop compare dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trading.1.betfanatics.com/trading/portal*"
      ],
      "js": [
        "content/portal-ids.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
